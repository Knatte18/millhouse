{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "millhouse",
  "version": "2.0.0",
  "description": "Multi-plugin marketplace for Claude Code (mill-v2)",
  "owner": {
    "name": "Knatte18"
  },
  "allowCrossMarketplaceDependenciesOn": ["scribe"],
  "plugins": [
    {
      "name": "mill",
      "description": "Task orchestration, git workflow, and documentation for Claude Code",
      "version": "2.0.0",
      "author": {
        "name": "Knatte18"
      },
      "source": "./plugins/mill",
      "category": "productivity"
    },
    {
      "name": "codeguide",
      "description": "Repo documentation generation and maintenance",
      "version": "1.0.0",
      "author": {
        "name": "Knatte18"
      },
      "source": "./plugins/codeguide",
      "category": "productivity"
    },
    {
      "name": "weblens",
      "description": "Fetch blocked/restricted web pages and output readable markdown",
      "version": "1.0.0",
      "author": {
        "name": "Knatte18"
      },
      "source": "./plugins/weblens",
      "category": "productivity"
    }
  ]
}
